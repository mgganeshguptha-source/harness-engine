# =============================================================================
# .harness/config.yaml — per-repo harness configuration
#
# Copy this into your service repository as .harness/config.yaml and adjust.
# Everything here is per-repo: the engine, the skills and the instruction files
# are central and shared, but the build commands, quality bar and gate modes
# belong to the service.
#
# ROLLOUT NOTE: blocker_gate and ac_gate default to "advisory" here on purpose.
# Both stop a run early, and switching them to "blocking" before you have seen
# them be right a few times is how a new control loses the room. Move them to
# "blocking" once the verdicts look sound on your codebase.
# =============================================================================
target_module: ""                       # blank => auto-detect the -application module

# ---------------------------------------------------------------- build
test_command: "./mvnw test"             # unit tests only (team DoD)
test_filter: ""                         # blank => run the whole suite
pre_validation_command: ""              # sample pom has no spring-javaformat plugin;
                                        # set the goal here once it does

# ---------------------------------------------------------------- coverage gate
min_coverage: 0.90                      # 90% line coverage on the CHANGED class
coverage_scope: "changed"
coverage_metric: "LINE"
coverage_csv: "target/site/jacoco/jacoco.csv"   # resolved module-aware at run time
coverage_command: "./mvnw jacoco:report"
coverage_loopback_phase: "unit_testing"
max_coverage_retries: 2

# ---------------------------------------------------------------- write boundary
write_exclude:                          # deny-wins; the -openapi-code module is
  - "**/generated/**"                   # auto-excluded too
  - "**/*MapperImpl.java"

repo_stacks: ["backend"]                # filters instruction files AND skills

# ---------------------------------------------------------------- model routing
model: "gpt-5-mini"                     # default for every phase
phase_models:
  design: "claude-sonnet-4.5"           # architecture decisions and trade-offs
  validation: "claude-sonnet-4.5"       # judging each acceptance criterion
  # unit_testing: "gpt-5.1-mini"        # re-enable once the model string is verified
review_model: "claude-haiku-4.5"        # code_review only — set HERE, not in phase_models
review_loopback_phase: "coding"
max_review_retries: 2

# ---------------------------------------------------------------- context gate
# Clarifications ALWAYS block, in every mode. This controls only the feasibility half.
blocker_gate: advisory                  # advisory for early runs; switch to blocking

# ---------------------------------------------------------------- AC conformance gate
ac_gate: advisory                       # advisory for early runs; switch to blocking
ac_loopback_phase: "coding"
max_ac_retries: 2
halt_on_inconclusive: false             # early UNVERIFIABLE = test-fixture gaps

# ---------------------------------------------------------------- termination
max_phase_runs: 3                              # global cap across all loop types
test_failure_loopback_phase: "unit_testing"    # test-compile failures go here, not coding
